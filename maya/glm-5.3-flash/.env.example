# Copy to .env; explicit environment assignments take precedence.
# Recipe config owns model paths, GPU selection and serving settings.
# MAYA_PYTHON=/absolute/path/to/python
# GLM_GGML_DIR=/absolute/path/to/pinned/llama.cpp
# Optional API authentication; never commit a real key.
# STRATA_API_KEY=replace-with-a-private-key
